{
  "name": "obsidian-writing-toolkit",
  "version": "1.0.9",
  "description": "写作工具箱：网文字数统计 / 码字时速 / 每日目标",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "check": "./node_modules/.bin/tsc --noEmit",
    "verify": "bash tools/checks/run-all.sh",
    "lint:review": "eslint src package.json",
    "release": "bash tools/release.sh",
    "lint:gate": "bash tools/lint-gate.sh"
  },
  "devDependencies": {
    "esbuild": "^0.20.0",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "0.4.2",
    "obsidian": "^1.14.4",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13"
  }
}
